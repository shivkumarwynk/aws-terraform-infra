{
    "family": "ship-website-staging",
    "containerDefinitions": [
        {
            "name": "ship-website",
            "image": "667173675677.dkr.ecr.ap-south-1.amazonaws.com/shipturtle-staging-web:latest",
            "cpu": 0,
            "portMappings": [
                {
                    "containerPort": 80,
                    "hostPort": 80,
                    "protocol": "tcp",
                    "name": "http",
                    "appProtocol": "http"
                }
            ],
            "essential": true,
            "environment": [],
            "mountPoints": [],
            "volumesFrom": [],
            "linuxParameters": {
                "capabilities": {
                    "add": [],
                    "drop": [
                        "NET_RAW"
                    ]
                },
                "initProcessEnabled": true
            },
            "stopTimeout": 30,
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/staging/ship-website",
                    "awslogs-region": "ap-south-1",
                    "awslogs-stream-prefix": "ship-website"
                },
                "secretOptions": []
            },
            "systemControls": []
        }
    ],
    "taskRoleArn": "arn:aws:iam::667173675677:role/shipturtle-dev-ecs-task-execution",
    "executionRoleArn": "arn:aws:iam::667173675677:role/shipturtle-dev-ecs-task-execution",
    "networkMode": "awsvpc",
    "volumes": [],
    "placementConstraints": [],
    "requiresCompatibilities": [
        "MANAGED_INSTANCES"
    ],
    "cpu": "1024",
    "memory": "1024",
    "tags": [
        {
            "key": "Environment",
            "value": "staging"
        },
        {
            "key": "Service",
            "value": "ship-website"
        }
    ]
}
