{
  "account_name": "enterprise",
  "region": "ap-south-1",
  "tags": {
    "Account": "enterprise",
    "ManagedBy": "Terraform",
    "Terraform": "true"
  },
  "defaults": {
    "network": {
      "availability_zone_count": 2,
      "enable_nat_gateway": true,
      "single_nat_gateway": true
    },
    "ec2": {
      "ami": "ami-019715e0d74f695be",
      "monitoring": false
    },
    "alb": {
      "create_external": false,
      "create_internal": true,
      "enable_http": true,
      "enable_https": false,
      "enable_internal_https": false,
      "external_certificate_arn": "",
      "internal_certificate_arn": "",
      "ssl_policy": "ELBSecurityPolicy-TLS13-1-2-Res-2021-06",
      "target_port": 8080,
      "health_check_path": "/",
      "enable_deletion_protection": false
    },
    "ecr": {
      "images_to_keep": 60
    }
  },
  "environments": {
    "prod": {
      "network": {
        "vpc_cidr": "10.14.0.0/16"
      },
      "ec2": {
        "key_name": "enterprise-prod",
        "instances": {}
      },
      "alb": {
        "create_external": true,
        "create_internal": true
      },
      "ecr": {
        "repository_name": "enterprise-prod"
      }
    },
    "staging": {
      "network": {
        "vpc_cidr": "10.15.0.0/16"
      },
      "ec2": {
        "key_name": "wynk-staging",
        "instances": {
          "vpn": {
            "instance_type": "t3a.medium",
            "subnet_type": "public",
            "subnet_index": 0,
            "security_group": "vpn",
            "tags": {
              "sprintoValue": "notprod"
            }
          },
          "jenkins": {
            "instance_type": "t3a.small",
            "subnet_type": "private",
            "subnet_index": 0,
            "security_group": "app",
            "tags": {
              "sprintoValue": "notprod"
            }
          },
          "mongo": {
            "instance_type": "t3a.small",
            "subnet_type": "private",
            "subnet_index": 1,
            "security_group": "database",
            "tags": {
              "sprintoValue": "notprod"
            }
          }
        }
      },
      "alb": {},
      "ecr": {
        "repository_name": "enterprise-staging"
      }
    },
    "dev": {
      "network": {
        "vpc_cidr": "10.16.0.0/16"
      },
      "ec2": {
        "key_name": "enterprise-dev",
        "instances": {}
      },
      "alb": {},
      "ecr": {
        "repository_name": "enterprise-dev"
      }
    }
  }
}
